rules_version = '2';

// Las fotos son privadas: solo el dueño las sube, las ve y las borra. Solo JPEG, PNG o WebP de hasta
// 2 MB (la app y la web las comprimen a JPEG antes de subirlas). Nada de SVG, que puede llevar scripts.
service firebase.storage {
  match /b/{bucket}/o {

    function esElDueno(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function esImagenLiviana() {
      return request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
    }

    match /garmentImages/{userId}/{fileName} {
      allow read, delete: if esElDueno(userId);
      allow write: if esElDueno(userId) && esImagenLiviana();
    }

    // Foto de perfil: un solo archivo por usuario, profileImages/{uid}.jpg
    match /profileImages/{fileName} {
      allow read, delete: if request.auth != null && fileName == request.auth.uid + '.jpg';
      allow write: if request.auth != null && fileName == request.auth.uid + '.jpg' && esImagenLiviana();
    }
  }
}
