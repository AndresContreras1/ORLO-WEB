# Secretos de desarrollo. Copia este archivo como backend/.env (está en .gitignore, no se sube)
# y pon tus valores. En producción este archivo no existe: todo llega por variables de entorno.

# Llave para firmar el JWT del panel: base64 de 32 bytes o más.
# Genera una con:  openssl rand -base64 32
ORLO_JWT_SECRET=

# Contraseña del administrador del panel (admin@orlo.co); se crea al arrancar si no existe
ORLO_ADMIN_PASSWORD=

# La clave de Anthropic NO va aquí: es la variable de usuario de Windows ORLO_ANTHROPIC_API_KEY
