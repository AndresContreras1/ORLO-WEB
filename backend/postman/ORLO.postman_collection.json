    {
      "key": "baseUrl",
      "value": "http://localhost:8090/api/v1"
    },
    {
      "key": "authEmulator",
      "value": "http://localhost:9099"
    },
    {
      "key": "firebaseApiKey",
      "value": "demo-api-key-solo-para-el-emulador"
    },
    {
      "key": "userEmail",
      "value": "andres.prueba@orlo.test"
    },
    {
      "key": "userPassword",
      "value": "Prueba2026"
    },
    {
      "key": "adminEmail",
      "value": "admin@orlo.co"
    },
    {
      "key": "adminPassword",
      "value": "OrloAdmin2026"
    },
    {
      "key": "firebaseToken",
      "value": ""
    },
    {
      "key": "adminToken",
